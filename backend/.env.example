# Copy to backend/.env and adjust. All keys use the ORGTRACK_ prefix.
ORGTRACK_DATABASE_URL=sqlite:///./orgtrack.db
# ORGTRACK_DATABASE_URL=postgresql+psycopg://orgtrack:secret@localhost:5432/orgtrack
ORGTRACK_JWT_SECRET=change-me
ORGTRACK_JWT_EXPIRY_MINUTES=600
# Dev sign-in lists demo accounts. Set to false once company SSO is wired.
ORGTRACK_DEV_LOGIN_ENABLED=true
ORGTRACK_CORS_ORIGINS=["http://localhost:5173"]

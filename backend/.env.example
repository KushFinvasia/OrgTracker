# Copy to backend/.env for local overrides. Settings use the ORGTRACK_ prefix (DATABASE_URL is also accepted).
ORGTRACK_ENVIRONMENT=development
# SQLite by default. Postgres URLs (postgres://, postgresql://) are converted to the psycopg driver automatically.
# DATABASE_URL=postgresql://orgtrack:secret@localhost:5432/orgtrack
ORGTRACK_JWT_SECRET=change-me
ORGTRACK_JWT_EXPIRY_MINUTES=600
# Dev sign-in by email for provisioned named accounts (until company SSO is wired).
ORGTRACK_DEV_LOGIN_ENABLED=true
# Shared code required on the sign-in page. Set it on any internet-facing deployment.
ORGTRACK_DEMO_ACCESS_CODE=
# Comma-separated exact origins, plus an optional regex for preview deployments.
ORGTRACK_CORS_ORIGINS=http://localhost:5173
# ORGTRACK_CORS_ORIGIN_REGEX=https://orgtrack-.*\.vercel\.app
